<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07090E"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="AI DRIVEN VPN"
            android:textColor="#00E5FF"
            android:textSize="16sp"
            android:letterSpacing="0.35"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="Zero-Trust Autonomous Security Shield"
            android:textColor="#80A0B0"
            android:textSize="11sp"
            android:letterSpacing="0.05"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>

    <!-- Node IP Config Card -->
    <LinearLayout
        android:id="@+id/serverConfigLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_metric_card"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/header">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TARGET NODE"
            android:textColor="#00E5FF"
            android:textSize="10sp"
            android:letterSpacing="0.1"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="14dp"
            android:layout_marginHorizontal="12dp"
            android:background="#20FFFFFF" />

        <EditText
            android:id="@+id/etServerIp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="192.168.68.67"
            android:textColorHint="#40FFFFFF"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:inputType="textUri"
            android:text="192.168.50.252" />
    </LinearLayout>

    <!-- Core Status Radar Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/statusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="#0F131D"
        app:cardCornerRadius="28dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/serverConfigLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieScan"
                android:layout_width="150dp"
                android:layout_height="150dp"
                app:lottie_rawRes="@raw/scanning"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_renderMode="hardware" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="SYSTEM ARMED"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:letterSpacing="0.15"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="00:00:00"
                android:textColor="#00E5FF"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Telemetry Info Grid -->
    <LinearLayout
        android:id="@+id/ipInfoSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_metric_card"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/statusCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REAL GATEWAY IP"
                    android:textColor="#00E5FF"
                    android:textSize="9sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvRealIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Detecting..."
                    android:textColor="#FFFFFF"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TUNNEL IP"
                    android:textColor="#00E5FF"
                    android:textSize="9sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvVpnIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Inactive"
                    android:fontFamily="monospace"
                    android:textColor="#60FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#15FFFFFF"
            android:layout_marginVertical="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GATEWAY NODE: "
                android:textColor="#00E5FF"
                android:textSize="9sp"
                android:letterSpacing="0.1"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Local Subnet Direct"
                android:textColor="#D0D0E0"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Network Metrics Grid -->
    <LinearLayout
        android:id="@+id/metricsMatrix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/ipInfoSection">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_metric_card"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LATENCY"
                android:textColor="#00E5FF"
                android:textSize="9sp"
                android:letterSpacing="0.1"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvPingVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="-- ms"
                android:textColor="#FFFFFF"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_metric_card"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NETWORK TYPE"
                android:textColor="#00E5FF"
                android:textSize="9sp"
                android:letterSpacing="0.1"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvNetworkVal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Initializing..."
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- AI Intelligence Console -->
    <LinearLayout
        android:id="@+id/aiConsole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_metric_card"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@id/metricsMatrix">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_green_dot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="GEMINI AI ORCHESTRATION ENGINE"
                android:textColor="#00E5FF"
                android:textSize="9sp"
                android:letterSpacing="0.15"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAiReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Monitoring local interfaces for transport vulnerabilities..."
            android:textColor="#C0C8D8"
            android:textSize="11sp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>

    <!-- Control Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggleVpn"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        android:text="SECURE CONNECTION"
        android:textColor="#07090E"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        app:backgroundTint="#00E5FF"
        app:cornerRadius="18dp"
        app:elevation="6dp"
        app:rippleColor="#4DFFFFFF"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>