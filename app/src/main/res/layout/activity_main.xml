<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D12"
    tools:context=".MainActivity">

    <!-- Thesis Title & Branding -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AEGIS SENTINEL"
            android:textColor="#00D2FF"
            android:textSize="14sp"
            android:letterSpacing="0.3"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cybersecurity Research Dashboard"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-light" />
    </LinearLayout>

    <!-- Main VPN Status Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/statusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:cardBackgroundColor="#131722"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieScan"
                android:layout_width="160dp"
                android:layout_height="160dp"
                app:lottie_rawRes="@raw/scanning"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_renderMode="hardware" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="SYSTEM READY"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textColor="#00D2FF"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- IP & Location Info -->
    <LinearLayout
        android:id="@+id/ipInfoSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_metric_card"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/statusCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="REAL IP" android:textColor="#00D2FF" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvRealIp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Detecting..." android:textColor="#FFFFFF" android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VPN IP" android:textColor="#00D2FF" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvVpnIp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Inactive" android:textColor="#80FFFFFF" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AFFFFFF" android:layout_marginVertical="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CURRENT NODE: " android:textColor="#00D2FF" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvLocation" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Local Gateway" android:textColor="#FFFFFF" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Network Telemetry Matrix -->
    <LinearLayout
        android:id="@+id/metricsMatrix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/ipInfoSection">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_metric_card"
            android:orientation="vertical"
            android:padding="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LATENCY" android:textColor="#00D2FF" android:textSize="10sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvPingVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- ms" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_metric_card"
            android:orientation="vertical"
            android:padding="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NETWORK" android:textColor="#00D2FF" android:textSize="10sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvNetworkVal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Initializing..." android:textColor="#FFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- AI Intelligence Core -->
    <LinearLayout
        android:id="@+id/aiConsole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_metric_card"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/metricsMatrix">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI ORCHESTRATION ENGINE"
            android:textColor="#00D2FF"
            android:textSize="10sp"
            android:letterSpacing="0.2"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAiReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ready for network integrity analysis..."
            android:textColor="#B0B0C0"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- Main Control Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggleVpn"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_margin="24dp"
        android:text="SECURE CONNECTION"
        android:textColor="#0A0D12"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        app:backgroundTint="#00D2FF"
        app:cornerRadius="20dp"
        app:elevation="8dp"
        app:rippleColor="#4DFFFFFF"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
