<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with NoActionBar to eliminate double title bar -->
    <style name="Theme.Vpn" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#00E5FF</item>
        <item name="colorPrimaryVariant">#090D16</item>
        <item name="colorOnPrimary">#090D16</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">#00E676</item>
        <item name="colorSecondaryVariant">#090D16</item>
        <item name="colorOnSecondary">#090D16</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">#090D16</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>